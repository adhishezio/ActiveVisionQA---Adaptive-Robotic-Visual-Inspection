<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ur">
  <!-- The installed upstream package supplies the arm and Gazebo controllers. -->
  <xacro:include filename="$(find ur_simulation_gz)/urdf/ur_gz.urdf.xacro"/>

  <link name="inspection_camera_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual>
      <geometry><box size="0.035 0.035 0.035"/></geometry>
      <material name="camera_blue"><color rgba="0.1 0.3 0.8 1"/></material>
    </visual>
    <collision><geometry><box size="0.035 0.035 0.035"/></geometry></collision>
  </link>
  <!-- Gazebo camera +x points along tool0 +z; all distances are meters. -->
  <joint name="tool_to_inspection_camera" type="fixed">
    <parent link="tool0"/><child link="inspection_camera_link"/>
    <origin xyz="0 0 0.08" rpy="0 -1.5707963267948966 0"/>
  </joint>
  <link name="inspection_camera_optical_frame"/>
  <!-- ROS optical coordinates use x right, y down and z forward. -->
  <joint name="inspection_camera_to_optical" type="fixed">
    <parent link="inspection_camera_link"/><child link="inspection_camera_optical_frame"/>
    <origin xyz="0 0 0" rpy="-1.5707963267948966 0 -1.5707963267948966"/>
  </joint>
  <gazebo reference="inspection_camera_link">
    <sensor name="inspection_camera" type="camera">
      <always_on>true</always_on>
      <update_rate>15</update_rate>
      <visualize>false</visualize>
      <topic>/inspection/camera/image_raw</topic>
      <gz_frame_id>inspection_camera_optical_frame</gz_frame_id>
      <camera>
        <horizontal_fov>1.0471975511965976</horizontal_fov>
        <image><width>800</width><height>600</height><format>R8G8B8</format></image>
        <clip><near>0.03</near><far>3.0</far></clip>
        <camera_info_topic>/inspection/camera/camera_info</camera_info_topic>
        <optical_frame_id>inspection_camera_optical_frame</optical_frame_id>
      </camera>
    </sensor>
  </gazebo>
</robot>
